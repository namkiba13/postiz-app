FROM ghcr.io/gitroomhq/postiz-app:v2.25.0@sha256:7eb4a553507ce3f200deff2ec0211ab3cf834ba19eb44dd68e83ccc236509feb

WORKDIR /app
COPY libraries ./libraries
COPY apps/backend ./apps/backend
RUN node libraries/nestjs-libraries/src/chat/tools/openviking.memory.check.cjs && node libraries/nestjs-libraries/src/chat/mastra.history.check.cjs && pnpm run build:backend && pnpm run build:orchestrator
COPY var/docker/public /app/public
COPY var/docker/nginx.conf /etc/nginx/nginx.conf
RUN nginx -t
